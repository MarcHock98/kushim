   "fy": {"rpn": [["v", 5], ["o", "neg"], ["v", 6], ["o", "*"], ["v", 7], ["v", 4], ["o", "*"], ["o", "-"]], "tex": "-m g - c\\, v_y"}
  },
  "paar": null,
  "federn": {"kette": true, "paare": [], "k": 40, "l0": 0.25, "daempfung": 0.05},
  "fest": [0, 11],
  "darstellung": [{"form": "koerper"}],
  "kennwerte": [], "erhaltung": null, "dt": 0.005, "laufzeit": 30, "tempo": 0, "spur": false,

  "darstellung": [{"form": "phasenraum", "x": "x", "y": "z"}, {"form": "zeitreihe", "groessen": ["x"]}],
  "kennwerte": [], "erhaltung": null, "dt": 0.005, "laufzeit": 30, "tempo": 0, "spur": true,
  "env": {"ode": ["t", "x", "y", "z", "s", "r", "bb"]}
 },
 "federkette": {
  "typ": "sim_eigen", "name": "Federkette", "beschreibung": "", "form": "teilchen",
  "parameter": [

   {"name": "c", "wert": 0.3, "min": 0, "max": 5, "einheit": "kg/s"},
   {"name": "m", "wert": 0.1, "min": 0.01, "max": 10, "einheit": "kg"}
  ],
  "anzahl": 12, "start": "linie", "punkte": [], "startwert": 1, "masse": 0.1, "kasten": [4, 3], "waende": "reflektieren",
  "kraft": {

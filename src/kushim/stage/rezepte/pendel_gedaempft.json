   "wert": 1,
   "min": 0.1,
   "max": 10,
   "einheit": "m"
  },
  {
   "name": "d",
   "wert": 0.2,
   "min": 0,
   "max": 5,
   "einheit": "1/s"
  }
 ],
 "zustand": [
  {
   "name": "phi",
   "start": 1.2,
